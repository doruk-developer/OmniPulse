        <!-- SAĞ (5 KOLON): EF CORE AUDIT INTERCEPTOR FORENSICS LOG -->
        <div class="col-lg-5">
            <div class="card bg-black border-danger h-100 shadow-sm">
                <div class="card-header bg-dark border-danger p-2 d-flex align-items-center justify-content-between">
                    <span class="text-danger fw-bold" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-fingerprint me-1"></i>EF CORE INTERCEPTOR AUDIT TRAIL
                    </span>
                    <span class="badge bg-danger text-white" style="font-size: 0.55rem;">IMMUTABLE_LOG</span>
