@{
    ViewData["Title"] = "Vehicle & Device Inventory // Global Audit Forensics";
    Layout = "_Layout";
}

<div class="container-fluid py-3" data-aos="fade-in">
    
    <!-- 🔴 ÜST BAŞLIK & DONANIM/ADLİ TIP ROZETLERİ -->
    <div class="page-header mb-3 pb-2 border-bottom border-secondary border-opacity-25">
        <div class="row align-items-center g-2">
            <div class="col-md-7">
                <div class="page-pretitle font-monospace mb-1 text-danger opacity-75 d-flex align-items-center gap-2" style="font-size: 0.7rem; letter-spacing: 1.5px;">
                    <i class="fa-solid fa-microchip text-danger"></i>
                    <span>OMNIPULSE HARDWARE MATRIX // EF CORE INTERCEPTOR AUDIT FORENSICS</span>
                </div>
                <h2 class="page-title font-monospace fw-bold text-white m-0 d-flex align-items-center gap-2" style="font-size: 1.6rem;">
                    <span class="status-dot status-danger status-dot-animated" style="width: 12px; height: 12px;"></span>
                    Vehicle & IoT Device Inventory (Global Audit Forensics)
                </h2>
            </div>
            
            <div class="col-md-5 text-end">
                <div class="d-flex align-items-center justify-content-md-end gap-2 font-monospace">
                    <div class="badge bg-black border border-danger text-danger p-2 text-start shadow-sm">
                        <div class="text-muted" style="font-size: 0.55rem;">HARDWARE PAIRING</div>
                        <span><i class="fa-solid fa-link me-1"></i>150 / 150 IoT SENSORS PAIRED</span>
                    </div>
                    <div class="badge bg-black border border-warning text-warning p-2 text-start shadow-sm">
                        <div class="text-muted" style="font-size: 0.55rem;">AUDIT TRAIL</div>
                        <span><i class="fa-solid fa-shield-cat me-1"></i>EF INTERCEPTOR ACTIVE</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🏷️ GLASS-BOX ARCHITECTURE BADGES (DONANIM & EF CORE AUDIT ODAKLI 4 OOP PRENSİBİ) -->
    <div class="row g-2 mb-3 font-monospace">
        <div class="col-12">
            <div class="card bg-black border-secondary p-2 shadow-sm">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2" style="font-size: 0.65rem;">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-muted fw-bold me-1"><i class="fa-solid fa-microchip text-danger me-1"></i>INVENTORY_MAPPING:</span>
                        
                        <!-- Encapsulation -->
                        <span class="badge bg-dark border border-danger text-danger p-2" data-bs-toggle="tooltip" title="Encapsulation: Cihaz MAC adresi ve donanım UUID bilgileri private encapsulation ile korundu.">
                            <i class="fa-solid fa-key text-danger me-1"></i>Encapsulation: Encapsulated Hardware UUID
                        </span>

                        <!-- Abstraction -->
                        <span class="badge bg-dark border border-info text-info p-2" data-bs-toggle="tooltip" title="Abstraction: IGenericRepository<TDevice> soyutlaması.">
                            <i class="fa-solid fa-cubes text-info me-1"></i>Abstraction: IGenericRepository&lt;Device&gt;
                        </span>

                        <!-- Inheritance -->
                        <span class="badge bg-dark border border-warning text-warning p-2" data-bs-toggle="tooltip" title="Inheritance: BaseEntity'den türeyen Audit alanları (CreatedBy, ModifiedBy, IsDeleted).">
                            <i class="fa-solid fa-sitemap text-warning me-1"></i>Inheritance: BaseEntity (Audit Columns)
                        </span>

                        <!-- Polymorphism -->
                        <span class="badge bg-dark border border-success text-success p-2" data-bs-toggle="tooltip" title="Polymorphism: IDeviceCommunicator üzerinden CAN-Bus, MQTT ve Modbus protokolleri.">
                            <i class="fa-solid fa-network-wired text-success me-1"></i>Polymorphism: IDeviceCommunicator (MQTT/CAN)
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-2 text-muted">
                        <span class="badge bg-dark border border-secondary text-danger"><i class="fa-solid fa-filter me-1"></i>SoftDelete QueryFilter: ENABLED</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🛠️ SIMULATION CONTROL TOOLBAR (ADLİ TIP VE DONANIM AKSİYON BUTONLARI) -->
