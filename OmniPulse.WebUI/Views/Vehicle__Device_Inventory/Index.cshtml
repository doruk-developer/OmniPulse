                    </button>
                    <button class="btn btn-sm btn-outline-warning" onclick="simulateSoftDelete()">
                        <i class="fa-solid fa-trash-arrow-up me-1"></i>Test Soft-Delete Interceptor
                    </button>
                    <button class="btn btn-sm btn-outline-info" onclick="generateQrTag()">
                        <i class="fa-solid fa-qrcode me-1"></i>Generate QR Asset Tag
                    </button>
                    <button class="btn btn-sm btn-outline-success" onclick="pairNewIotSensor()">
                        <i class="fa-solid fa-plug-circle-plus me-1"></i>Simulate IoT Sensor Pairing
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="exportAuditLogExcel()">
                        <i class="fa-solid fa-file-excel me-1"></i>Export Forensic Report
                    </button>
                </div>
            </div>
        </div>
    </div>

