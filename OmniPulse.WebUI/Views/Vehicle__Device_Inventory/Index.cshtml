@section Styles {
    <style>
        body {
            background-color: #050505 !important;
            color: #c5d1de;
        }

        #forensicAuditLogConsole::-webkit-scrollbar {
            width: 4px;
        }
        #forensicAuditLogConsole::-webkit-scrollbar-thumb {
            background: #d63939;
            border-radius: 2px;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            console.log('[AUDIT_FORENSICS]: EF Core Interceptor & Hardware Inventory Matrix Active.');
        });

        function appendForensicLog(msg, type = 'danger') {
            const consoleBox = document.getElementById('forensicAuditLogConsole');
            const entry = document.createElement('div');
            entry.className = `text-${type}`;
            entry.innerText = `>> [${new Date().toLocaleTimeString()}]: ${msg}`;
            consoleBox.appendChild(entry);
            consoleBox.scrollTop = consoleBox.scrollHeight;
        }

        // 🛠️ ADLİ TIP & DONANIM AKSİYONLARI

        function verifyAuditIntegrity() {
            appendForensicLog('SHA-512_INTEGRITY: Verifying cryptographic hashes across all 150 hardware nodes... OK!', 'success');
        }

        function simulateSoftDelete() {
            appendForensicLog('INTERCEPTOR_SOFT_DELETE: Intercepting SaveChangesAsync(). Entity [UUID-9910-0C] flagged as IsDeleted=true. Global QueryFilter will hide it from future queries.', 'warning');
            
            const badge = document.getElementById('softDeleteBadge');
            badge.className = 'badge bg-danger text-white';
            badge.innerText = 'IsDeleted = true (SOFT DELETED)';
        }

        function generateQrTag() {
            appendForensicLog('QRCODER_GENERATE: Generated Canvas QR Asset Tag for Node #3. Redirect URL: /Vehicle_Device_Inventory/Inspect/UUID-9910-0C', 'info');
            alert('QRCoder Asset Tag Generated!\n\nPayload: https://omnipulse.local/inventory/UUID-9910-0C\nStatus: Signed with QuantumSafeMinter SHA-512');
        }

        function pairNewIotSensor() {
            appendForensicLog('IOT_HOT_PLUG: New ApexThermal-PRO sensor detected on MQTT broker. Pairing with NODE-TR-06-04... Success!', 'success');
            
            const container = document.getElementById('newSensorCardContainer');
            container.innerHTML = `
                <div class="p-2 border border-success border-opacity-30 rounded bg-dark h-100 fade-in">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-success fw-bold"><i class="fa-solid fa-truck me-1"></i>NODE-TR-06-04</span>
                        <span class="badge bg-success text-black">PAIRED NOW</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.6rem;">
                        <div><strong>Vehicle:</strong> Ostim Lojistik Frigo #4</div>
                        <div><strong>Sensor Hardware:</strong> ApexThermal-v4 (Serial: <code>S-99201</code>)</div>
                        <div><strong>Protocol:</strong> MQTT over TLS</div>
                    </div>
                </div>
            `;
        }

        function exportAuditLogExcel() {
            appendForensicLog('CLOSEDXML_EXPORT: ClosedXML generated Excel Forensic Report with immutable timestamps.', 'info');
        }

        function inspectHardware(serial) {
            appendForensicLog(`HARDWARE_INSPECTOR: Fetching EEPROM and calibration ledger for Serial ${serial}...`, 'info');
        }
    </script>
}