@{
    ViewData["Title"] = "Time-Series Telemetry & Real-Time Projection";
    Layout = "_Layout";
}

<div class="container-fluid py-3" data-aos="fade-in">
    
    <!-- 🟢 ÜST BAŞLIK & MİMARİ ROZETLER -->
    <div class="page-header mb-3 pb-2 border-bottom border-secondary border-opacity-25">
        <div class="row align-items-center g-2">
            <div class="col-md-7">
                <div class="page-pretitle font-monospace mb-1 text-info opacity-75 d-flex align-items-center gap-2" style="font-size: 0.7rem; letter-spacing: 1.5px;">
                    <i class="fa-solid fa-chart-line text-success"></i>
                    <span>OMNIPULSE TIME-SERIES ENGINE // INFLUXDB 3.0 FLUX STREAMING CORE</span>
                </div>
                <h2 class="page-title font-monospace fw-bold text-white m-0 d-flex align-items-center gap-2" style="font-size: 1.6rem;">
                    <span class="status-dot status-success status-dot-animated" style="width: 12px; height: 12px;"></span>
                    Time-Series Telemetry & Real-Time Projection
                </h2>
            </div>
            
            <div class="col-md-5 text-end">
                <div class="d-flex align-items-center justify-content-md-end gap-2">
                    <div class="badge bg-black border border-danger text-danger font-monospace p-2 text-start shadow-sm" id="signalRStatusBadge">
                        <div class="text-muted" style="font-size: 0.55rem;">WEBSOCKETS (SIGNALR)</div>
                        <span><i class="fa-solid fa-rotate fa-spin me-1"></i>CONNECTING...</span>
                    </div>
                    <div class="badge bg-black border border-success text-success font-monospace p-2 text-start shadow-sm">
                        <div class="text-muted" style="font-size: 0.55rem;">FLUX QUERY ENGINE</div>
                        <span id="fluxQueryLatency"><i class="fa-solid fa-bolt me-1 text-warning"></i>0.14 ms (ACTIVE)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🏷️ FULL-STACK DATA PIPELINE GÖSTERGESİ -->
    <div class="row g-2 mb-3 font-monospace">
        <div class="col-12">
            <div class="card bg-black border-secondary p-2 shadow-sm">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2" style="font-size: 0.65rem;">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-muted fw-bold me-1"><i class="fa-solid fa-layer-group text-warning me-1"></i>PIPELINE:</span>
                        <span class="badge bg-dark border border-info text-info p-2">1. REST API (Http Post)</span>
                        <i class="fa-solid fa-arrow-right text-muted"></i>
                        <span class="badge bg-dark border border-success text-success p-2">2. Channel&lt;T&gt; Buffer</span>
                        <i class="fa-solid fa-arrow-right text-muted"></i>
                        <span class="badge bg-dark border border-warning text-warning p-2">3. BackgroundWorker</span>
                        <i class="fa-solid fa-arrow-right text-muted"></i>
                        <span class="badge bg-dark border border-danger text-danger p-2">4. SignalR Hub Push</span>
                        <i class="fa-solid fa-arrow-right text-muted"></i>
                        <span class="badge bg-dark border border-primary text-white p-2">5. Chart.js Render</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-muted">
                        <span class="badge bg-dark border border-secondary text-info" id="packetCounterBadge">Packets Received: 0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🛠️ SIMULATION CONTROL TOOLBAR -->
    <div class="card bg-black border-secondary mb-4">
        <div class="card-body p-2 font-monospace">
            <div class="row align-items-center g-2">
                <div class="col-md-4">
                    <span class="text-info fw-bold" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-sliders me-1"></i>TELEMETRY STREAM CONTROLS
                    </span>
                </div>
                <div class="col-md-8 text-md-end d-flex flex-wrap justify-content-md-end gap-2">
                    <button class="btn btn-sm btn-outline-warning" id="btnBurst" onclick="window.omniPulseEngine.triggerBurst()">
                        <i class="fa-solid fa-gauge-high me-1"></i>Stream Burst (API)
                    </button>
                    <button class="btn btn-sm btn-outline-danger" id="btnAnomaly" onclick="window.omniPulseEngine.injectAnomaly()">
                        <i class="fa-solid fa-temperature-arrow-up me-1"></i>Inject Thermal Drift (+9.4°C)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 📊 MULTI-CHANNEL CHART & LOGS -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card bg-black border-secondary h-100 shadow-sm">
                <div class="card-header bg-dark border-secondary p-2 d-flex align-items-center justify-content-between font-monospace">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-chart-area text-success"></i>
                        <span class="text-white fw-bold" style="font-size: 0.8rem;">REAL-TIME TELEMETRY PROJECTION (WEBSOCKETS)</span>
                    </div>
                    <span class="badge bg-black border border-success text-success pulse-anim" id="realTimeBadge" style="display:none; font-size: 0.6rem;">
                        <i class="fa-solid fa-circle me-1 text-success"></i>SYNCED
                    </span>
                </div>

                <div class="card-body p-3">
                    <div style="height: 360px; position: relative;">
                        <canvas id="multiChannelTelemetryChart"></canvas>
                    </div>

                    <!-- Cyberpunk Terminal Log -->
                    <div class="mt-3 p-2 bg-dark rounded border border-secondary font-monospace" style="font-size: 0.65rem; height: 110px; overflow-y: auto; scroll-behavior: smooth;" id="fluxLogConsole">
                        <div class="text-muted">>> [SYSTEM_INIT]: Engine instantiating...</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 font-monospace">
            <div class="card bg-black border-secondary h-100 shadow-sm">
                <div class="card-header bg-dark border-secondary p-2 d-flex align-items-center justify-content-between">
                    <span class="text-info fw-bold" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-microchip me-1"></i>AI FORENSICS & METRICS
                    </span>
                </div>

                <div class="card-body p-2 d-flex flex-column gap-2" style="font-size: 0.65rem;">
                    <div class="p-2 border border-danger border-opacity-30 rounded bg-dark">
                        <div class="d-flex justify-content-between text-danger fw-bold mb-1">
                            <span><i class="fa-solid fa-brain me-1"></i>MCP Agentic Predictor</span>
                            <span class="badge bg-danger text-white">POLYMORPHIC</span>
                        </div>
                        <div class="d-flex justify-content-between my-1">
                            <span class="text-muted">Drift Probability:</span>
                            <span class="text-success fw-bold" id="mcpDriftVal">0.02% (NOMINAL)</span>
                        </div>
                    </div>

                    <div class="p-2 border border-info border-opacity-30 rounded bg-dark">
                        <div class="d-flex justify-content-between text-info fw-bold mb-1">
                            <span><i class="fa-solid fa-memory me-1"></i>Memory Pool Status</span>
                            <span class="text-muted">Channel&lt;T&gt;</span>
                        </div>
                        <div class="progress mt-1" style="height: 4px;">
                            <div class="progress-bar bg-info transition-fast" style="width: 0%" id="channelProgressBar"></div>
                        </div>
                        <div class="text-muted text-end mt-1" style="font-size: 0.5rem;" id="bufferStatusTxt">Idle</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🌐 RAW PACKET TABLE -->
    <div class="row g-3">
        <div class="col-12 font-monospace">
            <div class="card bg-black border-secondary shadow-sm">
                <div class="card-header bg-dark border-secondary p-2 d-flex align-items-center justify-content-between">
                    <span class="text-white fw-bold" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-list-check me-2 text-success"></i>RAW TELEMETRY PACKET STREAM (UTC TIMESTAMPS)
                    </span>
                </div>
                <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                    <table class="table table-dark table-vcenter card-table table-hover align-middle mb-0" style="font-size: 0.7rem;">
                        <thead style="position: sticky; top: 0; background: #111827; z-index: 1;">
                            <tr class="text-muted border-secondary">
                                <th>PACKET ID</th>
                                <th>TIMESTAMP (UTC)</th>
                                <th>NODE / VEHICLE</th>
                                <th>TEMPERATURE</th>
                                <th>SPEED</th>
                                <th>LATENCY</th>
                            </tr>
                        </thead>
                        <tbody id="telemetryPacketTableBody">
                            <!-- Veriler SignalR ile canlı akacak -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body { background-color: #050505 !important; color: #c5d1de; }
        #fluxLogConsole::-webkit-scrollbar { width: 4px; }
        #fluxLogConsole::-webkit-scrollbar-thumb { background: #2fb344; border-radius: 2px; }
        .pulse-anim { animation: pulse 1.5s infinite alternate; }
        .transition-fast { transition: width 0.2s ease-in-out; }
        @@keyframes pulse { 0% { opacity: 1; box-shadow: 0 0 5px #2fb344; } 100% { opacity: 0.4; box-shadow: 0 0 0px #2fb344; } }
        .new-row-anim { animation: highlightRow 1s ease-out; }
        @@keyframes highlightRow { 0% { background-color: rgba(47, 179, 68, 0.2); } 100% { background-color: transparent; } }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        /**
         * 🚀 OMNIPULSE ENTERPRISE TELEMETRY ENGINE
         * Mimari: ES6 Class tabanlı, Kapsüllenmiş (Encapsulated) İstemci Motoru.
         * Özellikler: SignalR Lifecycle Yönetimi, Robust API İstekleri, DOM Optimizasyonu.
         */
        class TelemetryEngine {
            
            constructor() {
                this.chartInstance = null;
                this.signalRConnection = null;
                this.packetCount = 0;
                this.maxPointsOnChart = 25; // Ekranda kalacak maksimum nokta sayısı
                this.maxRowsInTable = 8;    // Tabloda kalacak maksimum satır
                
                // DOM Elements Caching (Performans için)
                this.dom = {
                    console: document.getElementById('fluxLogConsole'),
                    tableBody: document.getElementById('telemetryPacketTableBody'),
                    statusBadge: document.getElementById('signalRStatusBadge'),
                    realTimeBadge: document.getElementById('realTimeBadge'),
                    packetCounter: document.getElementById('packetCounterBadge'),
                    progressBar: document.getElementById('channelProgressBar'),
                    bufferStatus: document.getElementById('bufferStatusTxt'),
                    btnBurst: document.getElementById('btnBurst'),
                    btnAnomaly: document.getElementById('btnAnomaly')
                };
            }

            // --- 1. SİSTEM BAŞLATICI (INITIALIZER) ---
            async initialize() {
                this.log('Engine starting. Building Chart.js canvas...', 'info');
                this.buildChart();
                await this.connectWebSockets();
            }

            // --- 2. CHART.JS MİMARİSİ ---
            buildChart() {
                const ctx = document.getElementById('multiChannelTelemetryChart').getContext('2d');
                this.chartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: [],
                        datasets: [
                            {
                                label: 'Thermal Temp (°C)',
                                data: [],
                                borderColor: '#2fb344',
                                backgroundColor: 'rgba(47, 179, 68, 0.1)',
                                borderWidth: 2, fill: true, tension: 0.3, yAxisID: 'y'
                            },
                            {
                                label: 'Vehicle Speed (km/h)',
                                data: [],
                                borderColor: '#4299e1',
                                borderWidth: 1.5, borderDash: [3, 3], fill: false, tension: 0.2, yAxisID: 'y1'
                            },
                            {
                                label: 'Safe Threshold (+8.0°C)',
                                data: [], // Threshold statik tutulur
                                borderColor: '#d63939', borderWidth: 1.5, borderDash: [5, 5], pointRadius: 0, fill: false, yAxisID: 'y'
                            }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        animation: false, // Yüksek frekans akışı için animasyonlar kapatıldı (Enterprise Practice)
                        scales: {
                            y: { min: 0, max: 12, grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#2fb344' } },
                            y1: { min: 0, max: 140, position: 'right', grid: { drawOnChartArea: false }, ticks: { color: '#4299e1' } }
                        }
                    }
                });
            }

            // --- 3. SIGNALR (WEBSOCKETS) LIFECYCLE YÖNETİMİ ---
            async connectWebSockets() {
                this.signalRConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/telemetry")
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000]) // Enterprise Retry Policy
                    .configureLogging(signalR.LogLevel.Warning)
                    .build();

                // Yeniden Bağlanma Olayları (Resilience)
                this.signalRConnection.onreconnecting(error => {
                    this.updateConnectionStatus('WARNING', 'RECONNECTING...');
                    this.log(`SignalR connection lost. Attempting to reconnect: ${error}`, 'warning');
                });

                this.signalRConnection.onreconnected(connectionId => {
                    this.updateConnectionStatus('SUCCESS', 'CONNECTED');
                    this.log(`SignalR reestablished. Connection ID: ${connectionId}`, 'success');
                });

                // Veri Akış Dinleyicisi
                this.signalRConnection.on("ReceiveTelemetryPoint", (point) => this.handleIncomingTelemetry(point));

                try {
                    await this.signalRConnection.start();
                    this.updateConnectionStatus('SUCCESS', 'CONNECTED');
                    this.log('WebSockets handshake completed. Real-time stream active.', 'success');
                    this.dom.realTimeBadge.style.display = 'inline-block';
                } catch (err) {
                    this.updateConnectionStatus('DANGER', 'FAILED');
                    this.log(`WebSocket connection failed: ${err.message}`, 'danger');
                }
            }

            // --- 4. VERİ İŞLEME VE DOM MANİPÜLASYONU ---
            handleIncomingTelemetry(point) {
                this.packetCount++;
                this.dom.packetCounter.innerText = `Packets Received: ${this.packetCount}`;

                const dateObj = new Date(point.timestamp);
                const timeStr = `${dateObj.toLocaleTimeString()}.${dateObj.getMilliseconds().toString().padStart(3, '0')}`;
                
                // Grafik Güncellemesi
                const labels = this.chartInstance.data.labels;
                const datasets = this.chartInstance.data.datasets;

                labels.push(timeStr);
                datasets[0].data.push(point.temperature);
                datasets[1].data.push(point.speed);
                datasets[2].data.push(8.0); // Threshold Data

                if(labels.length > this.maxPointsOnChart) {
                    labels.shift();
                    datasets[0].data.shift();
                    datasets[1].data.shift();
                    datasets[2].data.shift();
                }
                
                // Chart.js'in yüksek performanslı çizim komutu
                this.chartInstance.update('none');

                // Tablo Güncellemesi
                this.prependTableRow(timeStr, point);
            }

            prependTableRow(timeStr, point) {
                const tr = document.createElement('tr');
                tr.className = 'new-row-anim'; // Saniyelik parlama efekti
                
                const isAnomaly = point.temperature > 8.0;
                const tempClass = isAnomaly ? "text-danger fw-bold" : "text-success fw-bold";
                const packetId = `PKT-${Math.random().toString(36).substr(2, 6).toUpperCase()}`;
                
                // Latency Simülasyonu (0.1ms - 0.4ms)
                const latency = (Math.random() * (0.4 - 0.1) + 0.1).toFixed(2);

                tr.innerHTML = `
                    <td><code>${packetId}</code></td>
                    <td><code>${timeStr}</code></td>
                    <td>${point.nodeId}</td>
                    <td class="${tempClass}">${point.temperature.toFixed(2)} °C</td>
                    <td class="text-info">${point.speed} km/h</td>
                    <td><span class="badge bg-dark border border-success text-success">${latency} ms</span></td>
                `;

                this.dom.tableBody.insertBefore(tr, this.dom.tableBody.firstChild);
                
                // Optimizasyon: Tablonun sonsuza uzamasını engelle
                if (this.dom.tableBody.children.length > this.maxRowsInTable) {
                    this.dom.tableBody.removeChild(this.dom.tableBody.lastChild);
                }
            }

            // --- 5. ROBUST REST API ÇAĞRILARI (FETCH) ---
            async triggerBurst() {
                this.setButtonState(this.dom.btnBurst, true);
                this.log('Sending burst POST request to /api/telemetry/simulate-burst...', 'warning');
                
                // Buffer UI Animasyonu
                this.dom.progressBar.style.width = '85%';
                this.dom.bufferStatus.innerText = 'Channel Queue: Processing...';

                try {
                    const response = await fetch('/api/telemetry/simulate-burst?count=15', { method: 'POST' });
                    if(!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    this.log('Burst payload accepted by Channel<T>. Worker processing...', 'success');
                } catch (error) {
                    this.log(`Burst request failed: ${error.message}`, 'danger');
                } finally {
                    this.setButtonState(this.dom.btnBurst, false);
                    setTimeout(() => {
                        this.dom.progressBar.style.width = '2%';
                        this.dom.bufferStatus.innerText = 'Channel Queue: Idle';
                    }, 1500);
                }
            }

            async injectAnomaly() {
                this.setButtonState(this.dom.btnAnomaly, true);
                this.log('Injecting Thermal Breach Payload (+9.4°C)...', 'danger');
                
                const payload = {
                    NodeId: "NODE-TR-06-03",
                    VehiclePlate: "00 ABC 00",
                    Temperature: 9.4,
                    Speed: 85,
                    Humidity: 40,
                    IsDoorOpen: false
                };

                try {
                    const response = await fetch('/api/telemetry/ingest', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    
                    if(!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    
                    // MCP AI UI Update
                    const mcpVal = document.getElementById('mcpDriftVal');
                    mcpVal.innerText = '98.8% (ANOMALY DETECTED!)';
                    mcpVal.className = 'text-danger fw-bold pulse-anim';

                } catch (error) {
                    this.log(`Anomaly injection failed: ${error.message}`, 'danger');
                } finally {
                    this.setButtonState(this.dom.btnAnomaly, false);
                }
            }

            // --- 6. YARDIMCI ARAÇLAR (UTILITIES) ---
            log(msg, type = 'info') {
                const entry = document.createElement('div');
                entry.className = `text-${type} mb-1`;
                entry.innerHTML = `<span class="opacity-50">[${new Date().toLocaleTimeString()}]</span> ${msg}`;
                this.dom.console.appendChild(entry);
                this.dom.console.scrollTop = this.dom.console.scrollHeight;
            }

            updateConnectionStatus(state, text) {
                let badgeClass = state === 'SUCCESS' ? 'border-success text-success' : 
                                 state === 'WARNING' ? 'border-warning text-warning' : 'border-danger text-danger';
                
                let iconClass = state === 'SUCCESS' ? 'fa-circle-check' :
                                state === 'WARNING' ? 'fa-rotate fa-spin' : 'fa-circle-xmark';

                this.dom.statusBadge.className = `badge bg-dark border ${badgeClass} font-monospace p-2 text-start shadow-sm`;
                this.dom.statusBadge.innerHTML = `<div class="text-muted" style="font-size: 0.55rem;">WEBSOCKETS (SIGNALR)</div><span><i class="fa-solid ${iconClass} me-1"></i>${text}</span>`;
            }

            setButtonState(btn, isDisabled) {
                if(btn) {
                    btn.disabled = isDisabled;
                    btn.style.opacity = isDisabled ? '0.5' : '1';
                }
            }
        }

        // Motoru Başlat (Singleton Instantiation)
        window.omniPulseEngine = new TelemetryEngine();
        document.addEventListener("DOMContentLoaded", () => {
            window.omniPulseEngine.initialize();
        });
    </script>
}