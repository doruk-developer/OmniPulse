@{ ViewData["Title"] = "Neural Reasoning Center"; Layout = "_Layout"; }
            <div class="cognitive-apex-wrapper" data-aos="fade-right">
                <header class="cognitive-header mb-5">
                    <h1 class="sys-project-brand m-0"><i class="fa-solid fa-brain text-info me-3"></i>NEURAL_REASONING_CENTER</h1>
                    <p class="tech-label-micro text-secondary">MODE: AUTONOMOUS_CHAIN_OF_THOUGHT_V5</p>
                </header>
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="card bg-black border-info shadow-lg h-100">
                            <div class="card-header border-info bg-dark font-monospace small">INTERROGATION_INPUT</div>
                            <div class="card-body p-4">
                                <div class="mb-4">
                                    <label class="tech-label-micro opacity-50 mb-2">SYSTEM_INTENT</label>
                                    <textarea id="reasoningInput" class="form-control bg-black border-secondary text-info font-monospace" rows="10" placeholder=">> Enter system intent..."></textarea>
                                </div>
                                <button class="btn btn-outline-info w-100 zenith-text py-3" onclick="executeChain()"><i class="fa-solid fa-bolt-lightning me-2"></i>EXECUTE_REASONING_CHAIN</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="card bg-black border-secondary shadow-lg h-100">
                            <div class="card-header border-secondary bg-dark font-monospace small text-success">NEURAL_OUTPUT_STREAM</div>
                            <div class="card-body p-0 position-relative bg-black" style="overflow: hidden;">
                                <div id="neuralStream" class="p-4 font-monospace extra-small" style="height: 500px; overflow-y: auto; color: #00ff00;">
                                    <div class="opacity-25 mt-5 text-center"><i class="fa-solid fa-terminal fa-3x mb-3"></i><p>AWAITING_NEURAL_STIMULUS...</p></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <script>
                function executeChain() {
                    const input = document.getElementById('reasoningInput').value;
                    const stream = document.getElementById('neuralStream');
                    if(!input) return;
                    stream.innerHTML = '<div class="text-info">>> INITIATING_CHAIN_OF_THOUGHT...</div>';
                    fetch('/Cognitive/api/neural/reasoning-chain', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Intent: input, SequenceId: crypto.randomUUID() })
                    })
                    .then(r => r.json())
                    .then(data => { stream.innerHTML += `<div class="mt-3 text-success">>> CONCLUSION: ${JSON.stringify(data.conclusion)}</div>`; });
                }
            </script>